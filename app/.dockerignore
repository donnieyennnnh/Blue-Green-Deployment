# Keep the build context tiny. Anything listed here is NOT sent to the
# Docker daemon when running `docker build`, so builds are faster and
# we don't accidentally bake secrets or local files into the image.

node_modules
npm-debug.log*
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
README.md
.env
.env.*
coverage
.nyc_output
test
tests
*.test.js
.vscode
.idea
