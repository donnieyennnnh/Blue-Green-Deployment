# inventory.ini.example — copy to inventory.ini and set the IP.
#   cp inventory.ini.example inventory.ini
#
# Get the current EC2 IP from Terraform:
#   cd ../terraform && terraform output -raw ec2_public_ip
#
# Or just use the helper:
#   ./generate-inventory.sh

[app]
ec2 ansible_host=203.0.113.42
