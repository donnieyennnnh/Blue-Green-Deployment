# =============================================================================
# .env.example — copy to .env and fill in. Never commit .env.
# =============================================================================
# This file documents every environment variable the project uses across all
# phases. Variables you don't need yet can stay blank; they get populated as
# we move through phases.

# ---- Phase 1: Local app ----
# Port the Express app listens on inside the container
APP_PORT=3000

# ---- Phase 2: Terraform / AWS ----
# These are read by Terraform (via TF_VAR_*) or by `aws` CLI directly.
# Preferred approach: run `aws configure --profile blue-green` and reference
# the profile instead of pasting keys here. These are for GitHub Actions use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Your public IP in CIDR form, used to lock SSH inbound to your machine only.
# Find it with: curl ifconfig.me  (then append /32)
MY_IP_CIDR=0.0.0.0/32

# EC2 instance type. t3.micro is free-tier eligible for 12 months on new
# accounts; t4g.small (ARM) is ~$0.0168/hr if free tier is exhausted.
EC2_INSTANCE_TYPE=t3.micro

# ---- Phase 2/3: SSH ----
# Path to the SSH *private* key that Terraform will register with AWS and
# Ansible will use to connect. Generate in Phase 2.
SSH_PRIVATE_KEY_PATH=~/.ssh/blue-green-ec2

# ---- Phase 2 output: populated after `terraform apply` ----
EC2_PUBLIC_IP=

# ---- Phase 4: GitHub Container Registry ----
# Classic PAT with write:packages, read:packages, delete:packages scopes.
# In GitHub Actions this comes from the built-in GITHUB_TOKEN; this is for
# local pushes and testing only.
GHCR_USERNAME=
GHCR_TOKEN=

# ---- Phase 7: Monitoring ----
# Grafana admin password for the provisioned dashboard
GRAFANA_ADMIN_PASSWORD=
